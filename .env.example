GEMINI_API_KEY=your_api_key_here

# Root / shared — copy to .env or .env.local (see .env.local.example)

# Backend (FastAPI)
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed to call this API (required for outbreak/chat from Next.js).
# Example: http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Database / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
HUGGINGFACE_API_KEY=
TEXT_MODEL=
VISION_MODEL=

# Frontend (Next.js) — also set in frontend/.env.local for `next dev`
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
