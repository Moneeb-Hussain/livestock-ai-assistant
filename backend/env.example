# ─────────────────────────────────────────────
# MaweshiAI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://maweshiai.pk

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key


TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
VISION_MODEL=google/gemini-flash-1.5
HUGGINGFACE_API_KEY=your-hf-api-key

# Groq (fast free-tier text LLM)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-8b-8192

# Outbreak detection thresholds
OUTBREAK_CASE_THRESHOLD=5
OUTBREAK_RADIUS_KM=10
OUTBREAK_WINDOW_HOURS=48

# File upload limits
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
