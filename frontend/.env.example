# Next.js client/server env (copy to frontend/.env.local)
# Omit NEXT_PUBLIC_API_BASE_URL to use same-origin proxies:
#   /api/maweshi-proxy/chat → rewrite → FastAPI chat
#   /api/maweshi-proxy/outbreaks → `app/api/maweshi-proxy/outbreaks/route.ts` → FastAPI
# Optional: override upstream for the outbreaks route only (server-side).
# MAWESHI_API_UPSTREAM=https://livestock-ai-assistant.onrender.com
# Optional: custom User-Agent for OSM Nominatim reverse geocode (see their usage policy).
# NOMINATIM_USER_AGENT=MaweshiAI/1.0 (your-contact-url-or-email)
# Prefer English place names (default en-US,en).
# NOMINATIM_ACCEPT_LANGUAGE=en-US,en
# If set, the browser calls this host directly — FastAPI must set CORS_ORIGINS to your site.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
